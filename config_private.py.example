# -*- coding: utf-8 -*-
"""
config_private.py.example — S-1 覆蓋層範本（2026-07-06）

用法：
  1. 本地開發：複製本檔為 `config_private.py`（同目錄，已在 .gitignore），
     填入真實部位數字。正本：vault「1b 1 BTC ROAD.md」§4.2 防守推移表。
  2. GitHub Actions：不使用本檔案，改設定 Repository Secret `DEFENSE_CONFIG_JSON`，
     內容為以下 JSON schema 的 minified 字串：

     {
       "alert_price_low": 99999.0,
       "defense_ladder": [
         [99999.0, "範例：動作A...", 0.0, 0.0, "附註..."],
         [88888.0, "範例：動作B...", 0.0, 0.0, "附註..."],
         [77777.0, "範例：動作C...", 0.0, 0.0, "附註..."]
       ],
       "defense_decision_card": ["文案1", "文案2", "文案3", "文案4"],
       "mart_tp_baseline": {"date": "YYYY-MM-DD", "marts": [
         {"name": "馬1", "tp": 99999.0, "rung": 1},
         {"name": "馬2", "tp": 88888.0, "rung": 3}]}
     }

     mart_tp_baseline 為「可選」鍵（P4 止盈重啟偵測基線，2026-07-13）：缺值＝
     偵測停用、警報回退靜態警語，不觸發 fail-loud。date=對帳基線日；tp=該輪
     推斷止盈價（均價×(1+tp%)）；rung=止盈重啟時作廢的防守階（1-based）。

  兩個來源缺一即可（config.py 優先讀 DEFENSE_CONFIG_JSON 環境變數，
  找不到才 import 本模組）；兩者都缺時 config.py 會 raise（fail-loud，
  憲法第 3 條），不會 fallback 到下方的範例假數字。

  🚫 **本檔一律只寫假數字（2026-08-21 立，違反＝資安事件）**
  本檔進公開版控（repo 為 public）。2026-07-06 S-1 私有化把真值搬進 gitignored 的
  config_private.py，但**本檔上方的 JSON schema 範例當時直接抄了真實的觸發價、釋出量
  與加保後強平價**，等於私有化做了一半——真數字仍公開可讀，2026-08-21 才發現並清掉。
  爾後新增/修改本檔的任何欄位範例，**數字一律用 99999/88888/77777 這類顯假值**，
  結構可以真、數字不准真。同一禁令適用於 README、CLAUDE.md、測試檔與 commit message。
  （測試若需真值驗算，走 `from config_private import ...` 並在缺檔時 skip，
  勿把真值寫進測試——現行 tests/test_defense_ladder.py 即此模式。）

  ⚠️ 同步義務（2026-07-14 稽核 No.1 立，改 config_private.py 後必走四步）：
  1. python scripts/defense_config_check.py       → 記本地指紋
  2. 更新 Repository Secret DEFENSE_CONFIG_JSON
  3. gh workflow run price_alert.yml -f verify_config=true
  4. LINE 收到 secret 側指紋，與步驟 1 一致才算同步完成

以下為**範例假數字**，僅供理解結構，不代表真實部位：
"""

ALERT_PRICE_LOW: float = 99_999.0  # 範例值，非真實

DEFENSE_LADDER: tuple = (
    (99_999.0, "範例：關閉馬丁1號，釋出 BTC 補入保證金", 0.0, 0.0, "範例附註"),
    (88_888.0, "範例：台股換 BTC 補入", 0.0, 0.0, "範例附註"),
    (77_777.0, "範例：關閉馬丁2號，釋出 BTC 補入", 0.0, 0.0, "範例附註"),
)

DEFENSE_DECISION_CARD: tuple = (
    "範例分區文案 1",
    "範例分區文案 2（2026-07-13 起中間區間語義=預設整梯放棄：S2×P-C 日線壓測四格全滅，下影線＋馬丁止盈重啟稀釋雙機制，「全有」分支已實證否決）",
    "範例分區文案 3",
    "範例分區文案 4",
    "範例反彈側出口文案（C-R5：回本點=減槓桿天然出口，下行卡+上行卡成對）",
    "範例預設政策文案（U5-2，2026-07-13：警報後 24h 未行動＝預設不防守——把「來不及」變成預選結果）",
)

# 測試自洽驗算用（tests/test_defense_ladder.py 讀不到 config_private 時該測試會 skip，
# 非公開 CI 環境不影響其他測試）。
LIQ_BASE: float = 99_999.0
POSITION_USD: float = 10_000.0

# P4 馬丁止盈重啟偵測基線（可選；刪除本段＝偵測停用）。範例假數字。
MART_TP_BASELINE: dict = {
    "date": "2026-01-01",
    "marts": [
        {"name": "馬1", "tp": 99_999.0, "rung": 1},
        {"name": "馬2", "tp": 88_888.0, "rung": 3},
    ],
}
